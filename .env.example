# Copier en .env (à la racine, à côté de docker-compose.yml). Ne jamais committer.
# Clé API Anthropic (console.anthropic.com) : active l'assistant IA et les rapports.
ANTHROPIC_API_KEY=
# Modèle (facultatif, par défaut claude-opus-5)
AI_MODEL=
# E-mails aux clients (facultatif). Sans SMTP_URL : mode journal, rien n'est envoyé.
# Exemple : smtps://utilisateur:motdepasse@smtp-relay.brevo.com:465
SMTP_URL=
# Adresse d'expédition (domaine vérifié chez le fournisseur d'e-mails)
EMAIL_FROM=
