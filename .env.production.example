# Copier en .env.production et compléter. Ne jamais committer ce fichier.
DOMAIN=resa.mon-golf.ma
# Lettres et chiffres uniquement, 24 caractères ou plus
POSTGRES_PASSWORD=
# IA (facultatif) : clé API Anthropic pour l'assistant et les rapports
ANTHROPIC_API_KEY=
# E-mails aux clients (facultatif). Sans SMTP_URL : mode journal, rien n'est envoyé.
# Exemple : smtps://utilisateur:motdepasse@smtp-relay.brevo.com:465
SMTP_URL=
# Adresse d'expédition (domaine vérifié chez le fournisseur d'e-mails)
EMAIL_FROM=
